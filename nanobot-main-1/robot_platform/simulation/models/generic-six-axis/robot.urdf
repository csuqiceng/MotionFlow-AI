<?xml version="1.0"?>
<!-- Demonstration-only kinematic model; it is not a calibrated production arm. -->
<robot name="generic_six_axis">
  <link name="base"><visual><geometry><cylinder radius="0.16" length="0.20"/></geometry></visual><collision><geometry><cylinder radius="0.16" length="0.20"/></geometry></collision></link>
  <link name="link_1"><visual><origin xyz="0 0 0.25"/><geometry><cylinder radius="0.09" length="0.50"/></geometry></visual><collision><origin xyz="0 0 0.25"/><geometry><cylinder radius="0.09" length="0.50"/></geometry></collision></link>
  <joint name="joint_1" type="revolute"><parent link="base"/><child link="link_1"/><origin xyz="0 0 0.10"/><axis xyz="0 0 1"/><limit lower="-2.967" upper="2.967" effort="100" velocity="2"/></joint>
  <link name="link_2"><visual><origin xyz="0 0 0.40"/><geometry><cylinder radius="0.075" length="0.80"/></geometry></visual><collision><origin xyz="0 0 0.40"/><geometry><cylinder radius="0.075" length="0.80"/></geometry></collision></link>
  <joint name="joint_2" type="revolute"><parent link="link_1"/><child link="link_2"/><origin xyz="0 0 0.50" rpy="0 1.5708 0"/><axis xyz="0 1 0"/><limit lower="-2.094" upper="2.094" effort="100" velocity="2"/></joint>
  <link name="link_3"><visual><origin xyz="0 0 0.35"/><geometry><cylinder radius="0.065" length="0.70"/></geometry></visual><collision><origin xyz="0 0 0.35"/><geometry><cylinder radius="0.065" length="0.70"/></geometry></collision></link>
  <joint name="joint_3" type="revolute"><parent link="link_2"/><child link="link_3"/><origin xyz="0 0 0.80"/><axis xyz="0 1 0"/><limit lower="-2.618" upper="2.618" effort="100" velocity="2"/></joint>
  <link name="link_4"><visual><origin xyz="0 0 0.14"/><geometry><cylinder radius="0.06" length="0.28"/></geometry></visual><collision><origin xyz="0 0 0.14"/><geometry><cylinder radius="0.06" length="0.28"/></geometry></collision></link>
  <joint name="joint_4" type="revolute"><parent link="link_3"/><child link="link_4"/><origin xyz="0 0 0.70" rpy="0 1.5708 0"/><axis xyz="1 0 0"/><limit lower="-3.141" upper="3.141" effort="50" velocity="3"/></joint>
  <link name="link_5"><visual><origin xyz="0 0 0.12"/><geometry><cylinder radius="0.05" length="0.24"/></geometry></visual><collision><origin xyz="0 0 0.12"/><geometry><cylinder radius="0.05" length="0.24"/></geometry></collision></link>
  <joint name="joint_5" type="revolute"><parent link="link_4"/><child link="link_5"/><origin xyz="0 0 0.28"/><axis xyz="0 1 0"/><limit lower="-2.094" upper="2.094" effort="50" velocity="3"/></joint>
  <link name="tool"><visual><origin xyz="0 0 0.10"/><geometry><cylinder radius="0.04" length="0.20"/></geometry></visual><collision><origin xyz="0 0 0.10"/><geometry><cylinder radius="0.04" length="0.20"/></geometry></collision></link>
  <joint name="joint_6" type="revolute"><parent link="link_5"/><child link="tool"/><origin xyz="0 0 0.24"/><axis xyz="0 0 1"/><limit lower="-6.283" upper="6.283" effort="30" velocity="4"/></joint>
</robot>
